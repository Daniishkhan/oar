{
  "name": "oar",
  "version": "0.1.0",
  "private": true,
  "description": "Remote Claude and Codex coding on boat.dev, from repository plans and Linear tasks to verified staging delivery.",
  "type": "module",
  "bin": {
    "oar": "dist/oar.mjs"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm format:check && pnpm lint && pnpm test",
    "install:local": "pnpm build && node scripts/install-local.mjs"
  },
  "dependencies": {
    "@boatdev/sdk": "^1.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
