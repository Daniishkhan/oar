[Unit]
Description=Agent Chrome (oar): persistent signed-in Chrome on :0, CDP on 127.0.0.1:9222
After=network-online.target
Wants=network-online.target

[Service]
User=user
Environment=HOME=/home/user
Environment=DISPLAY=:0
Environment=PATH=/home/user/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/user
# boat's Xorg :0 is not a unit we can order after; wait for its socket instead.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 120); do [ -S /tmp/.X11-unix/X0 ] && exit 0; sleep 1; done; echo "no X socket at :0" >&2; exit 1'
# A snapshot taken while Chrome ran leaves a lock naming a pid that may exist again after resume.
ExecStartPre=/bin/rm -f /srv/oar/chrome/SingletonLock /srv/oar/chrome/SingletonSocket /srv/oar/chrome/SingletonCookie
ExecStart=/usr/bin/google-chrome-stable \
  --user-data-dir=/srv/oar/chrome \
  --remote-debugging-port=9222 \
  --remote-allow-origins=http://127.0.0.1:9222,http://localhost:9222 \
  --force-renderer-accessibility \
  --no-first-run --no-default-browser-check \
  --password-store=basic \
  --disable-gpu --disable-dev-shm-usage \
  --disable-session-crashed-bubble --hide-crash-restore-bubble \
  --start-maximized \
  about:blank
Restart=always
RestartSec=2
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
