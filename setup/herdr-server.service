[Unit]
Description=Herdr server (oar) so `herdr --machine` works right after a resume
After=network-online.target
Wants=network-online.target

[Service]
User=user
Environment=HOME=/home/user
Environment=PATH=/home/user/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TERM=xterm-256color
Environment=DISPLAY=:0
Environment=PLAYWRIGHT_BROWSERS_PATH=/home/user/.local/share/ms-playwright
WorkingDirectory=/home/user
# systemd owns the server: a stray `herdr server` (started by hand or by a remote attach) holds the
# socket and makes this unit flap with "already running", so it is removed first.
ExecStartPre=-/usr/bin/pkill -u user -x herdr
ExecStart=/home/user/.local/bin/herdr server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
