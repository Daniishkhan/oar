[Unit]
Description=oar factory controller (Linear issues → agents on the worker VMs)
After=network-online.target tailscaled.service herdr-server.service
Wants=network-online.target

[Service]
User=user
Environment=HOME=/home/user
Environment=PATH=/home/user/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TERM=xterm-256color
EnvironmentFile=-/home/user/.config/oar/env
WorkingDirectory=/home/user
ExecStart=/home/user/.local/bin/oar factory serve
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
